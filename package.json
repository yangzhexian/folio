{
  "name": "folio-desktop",
  "private": true,
  "version": "0.4.4",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run check:public && node scripts/check-guides.mjs && npm run build && npm test && npm run check:rust && npm run test:e2e",
    "check:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check && cargo test --locked --manifest-path src-tauri/Cargo.toml",
    "check:native": "node scripts/check-native.mjs",
    "check:public": "node scripts/check-public.mjs",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "backend:build": "node scripts/build-desktop.mjs --backend-only",
    "desktop:build": "node scripts/build-desktop.mjs",
    "video:capture": "npm run capture --prefix video",
    "video:render": "npm run render --prefix video",
    "video:studio": "npm run audio --prefix video && npm run studio --prefix video",
    "video:check": "npm run typecheck --prefix video"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "6.4.299",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@tauri-apps/cli": "^2.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.0.0"
  }
}
