{
  "name": "folio-introduction",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "capture": "node scripts/capture.mjs",
    "audio": "node scripts/audio.mjs",
    "studio": "remotion studio src/index.tsx --public-dir=public",
    "typecheck": "tsc --noEmit",
    "stills": "node scripts/render.mjs --stills",
    "render": "node scripts/audio.mjs && node scripts/render.mjs",
    "refresh": "npm run capture && npm run render",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.538",
    "@remotion/cli": "4.0.538",
    "@remotion/renderer": "4.0.538",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "remotion": "4.0.538"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "~5.9.3"
  },
  "overrides": {
    "zod": "4.6.6"
  }
}
